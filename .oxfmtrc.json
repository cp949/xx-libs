{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "ignorePatterns": [
    "**/.turbo/**",
    "**/.claude/**",
    "**/.superpowers/**",
    "**/node_modules/**",
    "**/dist/**",
    "packages/*/CHANGELOG.md",
    "pnpm-lock.yaml",
    "docs/superpowers/**"
  ]
}
