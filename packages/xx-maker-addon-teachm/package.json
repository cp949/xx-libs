{
  "name": "@cp949/xx-maker-addon-teachm",
  "version": "1.0.0",
  "description": "티처블 머신(이미지·자세·소리) 모델을 iframe으로 실행하는 kodiny 메이커 애드온",
  "keywords": [
    "addon",
    "iframe",
    "kodiny",
    "maker",
    "teachable-machine"
  ],
  "homepage": "https://github.com/cp949/xx-libs/tree/main/packages/xx-maker-addon-teachm#readme",
  "bugs": {
    "url": "https://github.com/cp949/xx-libs/issues"
  },
  "license": "MIT",
  "author": "jjfive",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/xx-libs.git",
    "directory": "packages/xx-maker-addon-teachm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "check:escompat": "es-check es2019 --module dist/index.js && es-check es2019 dist/index.cjs && node scripts/check-banned-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@cp949/xx-kodiny-iframe": "workspace:*",
    "@cp949/xx-kodiny-iframe-proto": "workspace:*",
    "@cp949/xx-maker-interface": "workspace:*",
    "@types/node": "^22.14.1",
    "es-check": "9.8.1",
    "jsdom": "31.0.1",
    "rxjs": "^7.8.2",
    "tsdown": "0.23.7",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@cp949/xx-kodiny-iframe": "^1",
    "@cp949/xx-maker-interface": "^1",
    "rxjs": "^7"
  },
  "browserslist": [
    "chrome 75"
  ],
  "engines": {
    "node": ">=22"
  }
}
