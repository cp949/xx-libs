{
  "name": "@cp949/xx-maker-interface",
  "version": "1.0.0",
  "description": "kodiny 메이커의 애드온·설정 타입과 id 생성, 스테이지 좌표 변환 유틸",
  "keywords": [
    "addon",
    "kodiny",
    "maker",
    "types"
  ],
  "homepage": "https://github.com/cp949/xx-libs/tree/main/packages/xx-maker-interface#readme",
  "bugs": {
    "url": "https://github.com/cp949/xx-libs/issues"
  },
  "license": "MIT",
  "author": "jjfive",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/xx-libs.git",
    "directory": "packages/xx-maker-interface"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "check:escompat": "es-check es2019 --module dist/index.js && es-check es2019 dist/index.cjs && node scripts/check-banned-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "es-check": "9.8.1",
    "tsdown": "0.23.7",
    "vitest": "5.0.5"
  },
  "browserslist": [
    "chrome 75"
  ],
  "engines": {
    "node": ">=22"
  }
}
