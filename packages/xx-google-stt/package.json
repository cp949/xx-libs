{
  "name": "@cp949/xx-google-stt",
  "version": "1.0.0",
  "description": "socket.io 서버를 거쳐 Google 음성 인식(STT)을 쓰는 브라우저 클라이언트 라이브러리",
  "keywords": [
    "google",
    "microphone",
    "socket.io",
    "speech-to-text",
    "stt"
  ],
  "homepage": "https://github.com/cp949/xx-libs/tree/main/packages/xx-google-stt#readme",
  "bugs": {
    "url": "https://github.com/cp949/xx-libs/issues"
  },
  "license": "MIT",
  "author": "jjfive",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/xx-libs.git",
    "directory": "packages/xx-google-stt"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "check:escompat": "es-check es2019 --module dist/index.js && es-check es2019 dist/index.cjs && node scripts/check-banned-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "es-check": "9.8.1",
    "jsdom": "31.0.1",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.1",
    "tsdown": "0.23.7",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "rxjs": "^7",
    "socket.io-client": "^4"
  },
  "browserslist": [
    "chrome 75"
  ],
  "engines": {
    "node": ">=22"
  }
}
