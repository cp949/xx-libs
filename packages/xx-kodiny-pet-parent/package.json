{
  "name": "@cp949/xx-kodiny-pet-parent",
  "version": "1.0.0",
  "description": "부모 페이지에서 kodiny pet iframe을 제어하는 라이브러리",
  "keywords": [
    "iframe",
    "kodiny",
    "parent",
    "pet",
    "postMessage"
  ],
  "homepage": "https://github.com/cp949/xx-libs/tree/main/packages/xx-kodiny-pet-parent#readme",
  "bugs": {
    "url": "https://github.com/cp949/xx-libs/issues"
  },
  "license": "MIT",
  "author": "jjfive",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/xx-libs.git",
    "directory": "packages/xx-kodiny-pet-parent"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-eventemitter3"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "check:escompat": "es-check es2019 --module dist/index.js && es-check es2019 dist/index.cjs && node scripts/check-banned-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@cp949/xx-kodiny-pet-proto": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "es-check": "9.8.1",
    "jsdom": "31.0.1",
    "rxjs": "^7.8.2",
    "tsdown": "0.23.7",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "rxjs": "^7"
  },
  "browserslist": [
    "chrome 75"
  ],
  "engines": {
    "node": ">=22"
  }
}
